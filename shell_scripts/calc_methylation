load_6ma_beta <- function(file_path, is_sample2 = FALSE) {
    cat(sprintf("Processing %s...\n", basename(file_path)))

    cov_filter <- if (is_sample2) " && $10 <= 200" else ""

    # Precompute modified (n_mod + n_othermod) and total (coverage) in AWK.
    # Avoids carrying 3 separate count columns into R — they are only ever summed.
    # $10 = coverage, $12 = n_mod, $13 = n_canonical, $14 = n_othermod
    cmd <- sprintf(
        "zcat %s | awk '$4 == \"a\"%s {print $1, $2, $3, $10, $12+$14}'",
        file_path, cov_filter
    )

    dt <- fread(
        cmd = cmd,
        header = FALSE,
        col.names = c("chromosome", "start_pos", "end_pos", "T_strand", "M_strand"),
        colClasses = c("character", "integer", "integer", "integer", "integer")
    )

    if (nrow(dt) == 0L) {
        cat(sprintf("Warning: No 'a' sites found in %s\n", basename(file_path)))
        return(NULL)
    }

    cat("Collapsing strands...\n")
    # Cast inside the aggregation expression to guard against int32 overflow in sum()
    dt_collapsed <- dt[, .(
        M = sum(as.numeric(M_strand)),
        T = sum(as.numeric(T_strand))
    ), by = .(chromosome, start_pos, end_pos)]

    rm(dt); gc()

    dt_collapsed <- dt_collapsed[T >= min_cov]
    dt_collapsed[, beta := M / T]
    dt_collapsed
}
